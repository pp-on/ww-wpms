# Webwerk WordPress Management Suite Configuration
# Copy this file to .env and adjust values for your environment
# DO NOT commit .env to version control!

#===============================================================================
# DATABASE CONFIGURATION
#===============================================================================

# Database connection settings
DB_HOST=localhost
DB_USER=wordpress
DB_PASSWORD=your_secure_password_here

# Database name (auto-generated from directory name if not set)
# DB_NAME=

#===============================================================================
# WORDPRESS CONFIGURATION
#===============================================================================

# WP-CLI binary path
WP_CLI_PATH=/usr/local/bin/wp

# WordPress locale
WP_LOCALE=de_DE

# WordPress admin user
WP_ADMIN_USER=admin
WP_ADMIN_EMAIL=oswaldo.nickel@pfennigparade.de

# WordPress admin password (auto-generated if not set)
WP_ADMIN_PASSWORD=secret

# WordPress site title (auto-generated from directory if not set)
# WP_TITLE=

# WordPress URL (auto-generated from LOCAL_URL_BASE if not set)
# WP_URL=

# Debug mode default (true/false)
WP_DEBUG_DEFAULT=true

#===============================================================================
# GIT CONFIGURATION
#===============================================================================

# Git profiles: GIT_PROFILE_<name>="USER HOST PROTO"
#
# A profile is the ONLY source of clone URLs - no git account is hardcoded.
# Four parts: the profile name, the git user/organisation, the host, the protocol.
#
#   PROTO=ssh    HOST is usually a Host alias from ~/.ssh/config, where the real
#                hostname and the key live:  work:your_git_user/<repo>.git
#   PROTO=https  HOST is the hostname:       https://github.com/you/<repo>.git
#
# Keep your own profiles in ~/.env so they are not part of this repository.
# Manage them with:
#   webwerk get profiles                       list
#   webwerk set profile add                    add (asks for the four values)
#   webwerk set profile edit|rm|default NAME   change / remove / make default
#
# GIT_PROFILE_work="your_git_user your_ssh_host ssh"
# GIT_PROFILE_private="your_other_user github.com https"

# Profile used when install runs without -G
# GIT_PROFILE=work

#===============================================================================
# LOCAL DEVELOPMENT CONFIGURATION
#===============================================================================

# Base URL for local development
# WordPress URL will be: ${LOCAL_URL_BASE}/${directory_name}
# Must match an existing vhost with PHP-FPM. Override per-run with -b / --base-url.
# Nothing is hardcoded: if this stays unset, install asks once and saves it here.
# LOCAL_URL_BASE=your-host.local

# Web server type: apache (LAMP) or nginx (LEMP)
# Set to nginx to generate nginx.conf instead of .htaccess
WEBSERVER_TYPE=nginx

# PHP-FPM socket path (only used when WEBSERVER_TYPE=nginx)
# PHP_FPM_SOCKET=unix:/run/php/php-fpm.sock

# Add security hardening to nginx.conf (deny xmlrpc, security headers, etc.)
# Set to true for production/public servers; default false = minimal local dev config
NGINX_PRODUCTION=false

# PHP upload limits (used for nginx client_max_body_size and .htaccess php_value)
PHP_UPLOAD_MAX_FILESIZE=64M
PHP_POST_MAX_SIZE=64M

# Web server user and group for file permissions
WEBSERVER_USER=www-data
WEBSERVER_GROUP=www-data

#===============================================================================
# SITE OPTIONS
#===============================================================================

# Disable search engine indexing for development (true/false)
DISABLE_SEARCH_INDEXING=true

# WordPress Multisite
# WP_MULTISITE=false
# WP_MULTISITE_SUBDOMAINS=false   # true = subdomain network, false = subdirectory

# Force SSL (true/false)
FORCE_SSL=false

# Output formatting
OUTPUT_LINE_WIDTH=60

#===============================================================================
# DDEV CONFIGURATION (for containerized development)
#===============================================================================

# DDEV automatically configures these when using --mode=ddev:
# - DB_HOST=db
# - DB_USER=db
# - DB_PASSWORD=db
# - DB_NAME=db
# - WP_CLI_PATH=ddev wp
# - WP_URL=${directory_name}.ddev.site

#===============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
#===============================================================================

# Example: WSL2 specific settings
# if [[ "$(uname -a)" =~ WSL ]]; then
#     DB_HOST=127.0.0.1
#     LOCAL_URL_BASE=your-host.local
# fi

# Example: Production overrides
# if [[ "${ENVIRONMENT:-}" == "production" ]]; then
#     WP_DEBUG_DEFAULT=false
#     DISABLE_SEARCH_INDEXING=false
#     FORCE_SSL=true
# fi
